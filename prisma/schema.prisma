generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  REVIEW
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SocialPostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

enum SocialPostType {
  INSPIRATION
  DEVOTIONAL
  LEADERSHIP
  ENCOURAGEMENT
  PRODUCTIVITY
  ANNOUNCEMENT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  logoUrl     String?
  memberships Membership[]
  projects    Project[]
  socialPosts SocialPost[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Join model between a Profile and a Workspace, carrying the member's role
// within that workspace. A profile can belong to many workspaces, and a
// workspace can have many member profiles.
model Membership {
  id          String        @id @default(cuid())
  profileId   String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, workspaceId])
  @@index([workspaceId])
  @@index([profileId])
}

model Project {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  priority    Priority      @default(MEDIUM)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  createdBy   String?
  creator     Profile?      @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  tasks       Task[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// Mirrors the authenticated user from Neon Auth (neon_auth.user.id, a text id).
// Not a foreign key into neon_auth's schema (managed separately by Neon Auth) -
// this is app-owned profile data keyed by the same id.
model Profile {
  id              String            @id
  email           String            @unique
  name            String?
  avatarUrl       String?
  memberships     Membership[]
  createdProjects Project[]
  authoredPosts   SocialPost[]      @relation("SocialPostAuthor")
  reviewedPosts   SocialPost[]      @relation("SocialPostReviewer")
  approvedPosts   SocialPost[]      @relation("SocialPostApprover")
  postEvents      SocialPostEvent[] @relation("SocialPostEventActor")
  postComments    SocialComment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model SocialPost {
  id                String            @id @default(cuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title             String?
  body              String
  type              SocialPostType    @default(INSPIRATION)
  status            SocialPostStatus  @default(DRAFT)
  channels          String[]
  hashtags          String[]
  mediaUrl          String?
  authorProfileId   String?
  author            Profile?          @relation("SocialPostAuthor", fields: [authorProfileId], references: [id], onDelete: SetNull)
  reviewerProfileId String?
  reviewer          Profile?          @relation("SocialPostReviewer", fields: [reviewerProfileId], references: [id], onDelete: SetNull)
  approverProfileId String?
  approver          Profile?          @relation("SocialPostApprover", fields: [approverProfileId], references: [id], onDelete: SetNull)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  events            SocialPostEvent[]
  comments          SocialComment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([workspaceId])
}

// Immutable editorial history: created / submitted / approved / scheduled /
// published / sent back to draft. Real entries only - no fake activity.
model SocialPostEvent {
  id             String     @id @default(cuid())
  postId         String
  post           SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  actorProfileId String?
  actor          Profile?   @relation("SocialPostEventActor", fields: [actorProfileId], references: [id], onDelete: SetNull)
  action         String // created | submitted | approved | sent_back | scheduled | published | edited
  note           String?
  createdAt      DateTime   @default(now())

  @@index([postId])
}

model SocialComment {
  id              String     @id @default(cuid())
  postId          String
  post            SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorProfileId String?
  author          Profile?   @relation(fields: [authorProfileId], references: [id], onDelete: SetNull)
  body            String
  createdAt       DateTime   @default(now())

  @@index([postId])
}
